nextflow_workflow {

    name "Test Subworkflow BCFTOOLS_STATS_PLOT"
    script "../main.nf"
    workflow "BCFTOOLS_STATS_PLOT"

    tag "subworkflows"
    tag "subworkflows/bcftools_stats_plot"
    tag "subworkflows/../../modules/nf-core/bcftools/stats"
    tag "subworkflows/../../modules/nf-core/bcftools/plotvcfstats"
    tag "subworkflows/../../modules/nf-core/pigz/compress"


    test("variantcomposition - bcftools-stats-plot") {

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'Cantharis_rufa/analysis/icCanRufa1/variant_calling/GCA_947369205.1_OX376310.1_CANBKR010000003.1.pacbio.icCanRufa1_deepvariant.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'Cantharis_rufa/analysis/icCanRufa1/variant_calling/GCA_947369205.1_OX376310.1_CANBKR010000003.1.pacbio.icCanRufa1_deepvariant.vcf.gz.tbi', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.stats.get(0).get(1)).readLines()[0..5],
                    workflow.out.compressed_stats,
                    workflow.out.plot_pdf.collect { meta, files -> [meta, file(files).name] },
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }

    test("variantcomposition - bcftools-stats-plot - only individual pdf") {
        config "./individual_pdf.config"

        when {
            workflow {
                """
                input[0] = channel.of([
                    [ id:'test' ], // meta map
                    file(params.modules_testdata_base_path + 'Cantharis_rufa/analysis/icCanRufa1/variant_calling/GCA_947369205.1_OX376310.1_CANBKR010000003.1.pacbio.icCanRufa1_deepvariant.vcf.gz', checkIfExists: true),
                    file(params.modules_testdata_base_path + 'Cantharis_rufa/analysis/icCanRufa1/variant_calling/GCA_947369205.1_OX376310.1_CANBKR010000003.1.pacbio.icCanRufa1_deepvariant.vcf.gz.tbi', checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(
                    file(workflow.out.stats.get(0).get(1)).readLines()[0..5],
                    workflow.out.compressed_stats,
                    workflow.out.plot_pdf.collect { meta, files -> [meta, files.collect { file(it).name }] },
                    workflow.out.findAll { key, val -> key.startsWith("versions") }
                ).match() }
            )
        }
    }
}
