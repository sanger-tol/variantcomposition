process {
    withName: VCFTOOLS_SITE_PI {
        ext.args = "--site-pi"
    }

    withName: VCFTOOLS_HET {
        ext.args = "--het"
    }

    withName: VCFTOOLS_SNP_DENSITY {
        ext.args = "--SNPdensity 1000"
    }

    withName: VCFTOOLS_ALLELE_FREQUENCY {
        ext.args = "--freq"
    }

    withName: VCFTOOLS_INDEL_LENGTH {
        ext.args = "--hist-indel-len"
    }

    withName: BGZIPTABIX_PI {
        ext.args2 = '-b 2 -e 2 -S 1'
    }

    withName: BGZIPTABIX_SD {
        ext.args2 = '-b 2 -e 2 -S 1'
        ext.prefix = { "${meta.id}.1k" }
    }

    withName: BGZIPTABIX_AF {
        ext.args2 = '-b 2 -e 2 -S 1'
    }
}
