nextflow_process {

    name "Test Process BCFTOOLS_PLOTVCFSTATS"
    script "../main.nf"
    process "BCFTOOLS_PLOTVCFSTATS"

    tag "modules"
    tag "modules_sangertol"
    tag "bcftools"
    tag "bcftools/plotvcfstats"
    tag "modules/nf-core/bcftools/stats"

    setup {

        run("BCFTOOLS_STATS") {
            script "../../../nf-core/bcftools/stats/main.nf"
            process {
                """
                input[0] = [
                    [ id: "test" ], // meta map
                    file(params.modules_testdata_base_path + 'Cantharis_rufa/analysis/icCanRufa1/variant_calling/GCA_947369205.1_OX376310.1_CANBKR010000003.1.pacbio.icCanRufa1_deepvariant.vcf.gz'),
                    file(params.modules_testdata_base_path + 'Cantharis_rufa/analysis/icCanRufa1/variant_calling/GCA_947369205.1_OX376310.1_CANBKR010000003.1.pacbio.icCanRufa1_deepvariant.vcf.gz.tbi') ] }
                input[1] = [[:],[]]
                input[2] = [[:],[]]
                input[3] = [[:],[]]
                input[4] = [[:],[]]
                input[5] = [[:],[]]
                """
            }
        }
    }


    test("BCFTOOLS - PLOTVCFSTATS") {

        when {
            process {
                """
                input[0] = BCFTOOLS_STATS.out.stats
                """
            }
        }

        then {
            def stable_data_output = getAllFilesFromDir(process.out.plot_dir.get(0).get(1), ignore: [ '*.{aux,tex,log,pdf}' ] )
            assertAll(
                { assert process.success },
                { assert snapshot(stable_data_output).match() }
            )
        }

    }

    test("BCFTOOLS - PLOTVCFSTATS - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = BCFTOOLS_STATS.out.stats
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
